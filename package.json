{
  "name": "mcp-kanji-stroke-order",
  "version": "0.1.0",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "graph": "node scripts/build-graph.mjs",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck:ui": "tsc -p ui/tsconfig.json",
    "build": "npm run build:ui && tsc",
    "start": "node build/index.js",
    "dev": "npm run build:ui && tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5",
    "firebase-admin": "^13",
    "zod": "^3.25"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "tsx": "^4",
    "typescript": "^5"
  }
}
